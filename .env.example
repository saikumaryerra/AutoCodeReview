# ═══════════════════════════════════════════════════════
#  REPOSITORY SOURCES — configure one or both providers
# ═══════════════════════════════════════════════════════

# ── GitHub (optional — omit if only using Azure DevOps) ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPOS=myorg/backend-api,myorg/frontend-app

# ── Azure DevOps (optional — omit if only using GitHub) ──
AZURE_DEVOPS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/myorg
AZURE_DEVOPS_REPOS=MyProject/backend-service,MyProject/web-frontend

# ── Polling ─────────────────────────────────────────
POLL_INTERVAL_SECONDS=3600

# ── Claude CLI ──────────────────────────────────────
CLAUDE_CLI_PATH=claude
CLAUDE_REVIEW_TIMEOUT_SECONDS=300
CLAUDE_MODEL=

# ── Server ──────────────────────────────────────────
# API_PORT (optional): leave unset so each context uses its own default —
# 3001 for local/dev (config.ts), 9998 in the prod Docker image (Dockerfile ENV).
# Set it explicitly only to override both. Note: docker-compose injects this file
# via env_file, so an explicit value here also becomes the prod container's port.
#API_PORT=
FRONTEND_PORT=5173
# CORS_ORIGINS (optional): comma-separated allowlist. Leave blank in production
# (the SPA is served same-origin). Only needed for cross-origin API access.
CORS_ORIGINS=

# ── Storage ─────────────────────────────────────────
DB_PATH=./data/reviews.db
REPOS_DIR=./data/repos

# ── Review Behavior ─────────────────────────────────
PR_STATE_FILTER=open
SKIP_DRAFTS=true
MAX_FILES_CHANGED=50
MAX_DIFF_SIZE=100000
REVIEW_RETRY_ENABLED=true
REVIEW_MAX_RETRY_ATTEMPTS=10

# ── Data Retention ──────────────────────────────────
REVIEW_RETENTION_DAYS=90
