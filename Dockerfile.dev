# ============================================================================
# AutoCodeReview — Development Dockerfile
# ============================================================================
# Single-stage image for local development with hot-reload.
# Source code is volume-mounted at runtime so rebuilds are instant.
# Runs backend (tsx watch) and frontend (vite dev) concurrently.
# ============================================================================

FROM node:20-slim

# System deps needed at dev time
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl unzip ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Claude CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Use the base image's built-in `node` user (UID 1000) so the container
# matches the host developer's UID. This lets the bind-mounted Claude CLI
# credentials (~/.claude/.credentials.json, mode 0600, owned by host UID
# 1000) remain readable even after Claude CLI rewrites the file during
# OAuth refresh — no permissions race.
RUN mkdir -p /app/data/repos /app/data/logs && \
    chown -R node:node /app

WORKDIR /app
USER node

# Install backend dependencies
COPY --chown=node:node package.json package-lock.json tsconfig.json ./
RUN npm ci

# Install frontend dependencies
COPY --chown=node:node frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

# Copy all source (will be overridden by volume mount in docker-compose)
COPY --chown=node:node . .

ENV NODE_ENV=development
ENV DB_PATH=/app/data/reviews.db
ENV REPOS_DIR=/app/data/repos
ENV API_PORT=3001
ENV FRONTEND_PORT=5173

EXPOSE 3001 5173

# concurrently runs backend tsx watch + frontend vite dev server
CMD ["npx", "concurrently", \
     "--names", "api,web", \
     "--prefix-colors", "blue,green", \
     "npx tsx watch src/index.ts", \
     "cd frontend && npx vite --host 0.0.0.0"]
